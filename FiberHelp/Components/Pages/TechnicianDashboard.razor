@page "/technician"
@page "/technician/dashboard"
@using FiberHelp.Models
@using System.Linq
@inject FiberHelp.Services.AdminService AdminService
@inject FiberHelp.Services.AuthService AuthService
@inject FiberHelp.Services.TransactionService TransactionService
@inject NavigationManager NavigationManager

<link href="css/dashboard.css" rel="stylesheet" />

<style>
    .tech-dashboard { padding: 24px; background: var(--bg); min-height: 100vh; color: var(--text-main); }
    .tech-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; border-bottom: 1px solid var(--border-color); padding-bottom: 24px; }
    .tech-header h1 { font-size: 32px; font-weight: 900; color:var(--text-main); margin: 0; letter-spacing: -0.02em; }
    .tech-welcome { color:var(--text-muted); font-size: 15px; font-weight: 500; }
    .tech-service-area { display: flex; align-items: center; gap: 8px; color: var(--success); font-size: 14px; margin-top: 8px; font-weight: 600; }
    
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin-bottom: 32px; }
    .stat-card { background:var(--card-bg); border-radius: 16px; padding: 24px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm); }
    .stat-card.pending { border-left: 4px solid #f59e0b; }
    .stat-card.inprogress { border-left: 4px solid #3b82f6; }
    .stat-card.resolved { border-left: 4px solid #10b981; }
    .stat-card.feedback { border-left: 4px solid #8b5cf6; }
    .stat-value { font-size: 40px; font-weight: 900; color:var(--text-main); line-height: 1; }
    .stat-label { font-size: 13px; color:var(--text-muted); margin-top: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
    
    .panel { background:var(--card-bg); border-radius: 16px; padding: 24px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm); margin-bottom: 24px; }
    .panel-title { font-size: 20px; font-weight: 800; margin-bottom: 20px; color:var(--text-main); display: flex; align-items: center; gap: 10px; }
    
    .ticket-list { display: flex; flex-direction: column; gap: 16px; }
    .ticket-item { background:var(--card-bg); border:1px solid var(--border-color); border-radius: 12px; padding: 20px; transition: all 0.2s ease; }
    .ticket-item:hover { transform: translateY(-2px); border-color: var(--success); box-shadow: 0 4px 12px rgba(16,185,129,0.15); }
    .ticket-item-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .ticket-id { font-weight: 800; color: var(--success); font-family: monospace; font-size: 15px; }
    .ticket-title { font-weight: 700; color:var(--text-main); font-size: 18px; margin-bottom: 6px; }
    .ticket-meta { font-size: 13px; color:var(--text-muted); display: flex; gap: 20px; }
    
    .badge { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge.assigned { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .badge.inprogress { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .badge.high { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .badge.medium { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .badge.low { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .badge.technician { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
    .badge.proof { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59,130,246,0.2); }
    .badge.feedback-received { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 1px solid rgba(139,92,246,0.2); }
    
    .btn { padding: 10px 18px; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
    .btn.primary { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
    .btn.primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
    .btn.success { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
    .btn.outline { background: transparent; border:1px solid var(--border-color); color:var(--text-main); }
    .btn.outline:hover { background: rgba(255,255,255,0.05); }
    .btn.feedback { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; font-size: 12px; }
    
    .ticket-actions { display: flex; gap: 12px; margin-top: 16px; }
    
    .empty-state { text-align: center; padding: 60px 20px; color:var(--text-muted); }
    .empty-state svg { width: 48px; height: 48px; margin-bottom: 16px; opacity: 0.3; }
    
    /* Resolve Modal */
    .modal-bg { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); display: grid; place-items: center; z-index: 20000; }
    .modal-card { background:var(--card-bg); border-radius: 20px; border: 1px solid var(--border-color); padding: 32px; width: 500px; max-width: 95vw; box-shadow: var(--shadow-lg); }
    .modal-header h3 { margin: 0; font-size: 24px; font-weight: 800; color: var(--text-main); }
    .modal-body { margin-top: 20px; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-weight: 700; margin-bottom: 8px; color:var(--text-main); font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; }
    .form-input { width: 100%; padding: 12px 16px; border: 1px solid var(--border-color); background: var(--bg); color: var(--text-main); border-radius: 10px; font-size: 15px; }
    .form-input:focus { outline: none; border-color: var(--success); box-shadow: 0 0 0 4px rgba(16,185,129,0.1); }
    textarea.form-input { min-height: 120px; resize: vertical; }
    
    .client-name { color: var(--primary); font-weight: 700; }
    .resolution-notes { margin-top:12px; padding:12px; background:rgba(16, 185, 129, 0.05); border: 1px solid rgba(16,185,129,0.1); border-radius:10px; font-size:14px; color: var(--text-main); }
</style>

@if (!AuthService.IsAuthenticated || !AuthService.IsTechnician)
{
    <div class="access-denied" style="text-align: center; padding: 100px 20px; background: var(--bg); min-height: 100vh;">
        <h2 style="color: var(--danger); font-size: 32px; font-weight: 900;">Access Denied</h2>
        <p style="color: var(--text-muted); font-size: 18px; margin-top: 12px;">This page is only accessible to Technicians.</p>
        <button class="btn primary" style="margin-top: 32px;" @onclick='() => NavigationManager.NavigateTo("/login")'>Go to Login</button>
    </div>
}
else
{
    <div class="tech-dashboard">
        <header class="tech-header">
            <div>
                <p class="tech-welcome">Welcome back,</p>
                <h1>@AuthService.FullName</h1>
                @if (!string.IsNullOrEmpty(AuthService.ServiceArea))
                {
                    <div class="tech-service-area">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        @AuthService.ServiceArea
                    </div>
                }
            </div>
            <div>
                <span class="badge technician">Technician Account</span>
            </div>
        </header>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card pending">
                <div class="stat-value">@pendingCount</div>
                <div class="stat-label">Pending</div>
            </div>
            <div class="stat-card inprogress">
                <div class="stat-value">@inProgressCount</div>
                <div class="stat-label">Working</div>
            </div>
            <div class="stat-card resolved">
                <div class="stat-value">@resolvedTodayCount</div>
                <div class="stat-label">Solved Today</div>
            </div>
            <div class="stat-card feedback">
                <div class="stat-value">@feedbackCount</div>
                <div class="stat-label">Feedback</div>
            </div>
        </div>

        <!-- Assigned Tickets -->
        <section class="panel">
            <h2 class="panel-title">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                My Current Assignments
            </h2>
            
            @if (isLoading)
            {
                <div class="empty-state">
                    <p>Fetching your tickets...</p>
                </div>
            }
            else if (assignedTickets == null || !assignedTickets.Any())
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="1.5"/>
                    </svg>
                    <p>Clear skies! No tickets assigned.</p>
                </div>
            }
            else
            {
                <div class="ticket-list">
                    @foreach (var ticket in assignedTickets.Where(t => t.Status != "Resolved" && t.Status != "Closed"))
                    {
                        <div class="ticket-item">
                            <div class="ticket-item-header">
                                <div>
                                    <span class="ticket-id">#@ticket.Id</span>
                                    <span class="badge @GetPriorityClass(ticket.Priority)" style="margin-left: 8px;">@ticket.Priority</span>
                                </div>
                                <span class="badge @GetStatusClass(ticket.Status)">@ticket.Status</span>
                            </div>
                            <div class="ticket-title">@ticket.Title</div>
                            <div class="ticket-meta">
                                <span>Client: <span class="client-name">@(string.IsNullOrEmpty(ticket.ClientName) ? "No Client" : ticket.ClientName)</span></span>
                                <span>Assigned: @(ticket.AssignedAt?.ToString("MMM dd, h:mm tt") ?? "N/A")</span>
                            </div>
                            <div class="ticket-actions">
                                @if (ticket.Status == "Assigned")
                                {
                                    <button class="btn primary" @onclick="() => StartProgress(ticket)">Start Work</button>
                                }
                                @if (ticket.Status == "Assigned" || ticket.Status == "In Progress")
                                {
                                    <button class="btn success" @onclick="() => OpenResolveModal(ticket)">Resolve Ticket</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Recently Resolved -->
        <section class="panel">
            <h2 class="panel-title">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                History & Proofs
            </h2>
            @if (resolvedTickets != null && resolvedTickets.Any())
            {
                <div class="ticket-list">
                    @foreach (var ticket in resolvedTickets.Take(5))
                    {
                        <div class="ticket-item" style="opacity: 0.9;">
                            <div class="ticket-item-header">
                                <div>
                                    <span class="ticket-id">#@ticket.Id</span>
                                    @if (ticketProofs.ContainsKey(ticket.Id))
                                    {
                                        <span class="badge proof" style="margin-left:8px;">Proof Sent</span>
                                    }
                                    @if (ticketFeedbacks.Contains(ticket.Id))
                                    {
                                        <span class="badge feedback-received" style="margin-left:4px;">Feedback Recv</span>
                                    }
                                </div>
                                <span class="badge" style="background:rgba(16, 185, 129, 0.1); color:var(--success);">Resolved</span>
                            </div>
                            <div class="ticket-title">@ticket.Title</div>
                            <div class="ticket-meta">
                                <span>Client: <span class="client-name">@(string.IsNullOrEmpty(ticket.ClientName) ? "Unknown" : ticket.ClientName)</span></span>
                                <span>Resolved: @(ticket.ResolvedAt?.ToString("MMM dd, h:mm tt") ?? "N/A")</span>
                            </div>
                            @if (ticketProofs.ContainsKey(ticket.Id))
                            {
                                <div class="resolution-notes" style="background: rgba(59, 130, 246, 0.05); border-color: rgba(59, 130, 246, 0.1);">
                                    <strong>TX Proof Ref:</strong> <span style="font-family:monospace; font-weight:700;">@ticketProofs[ticket.Id]</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(ticket.ResolutionNotes))
                            {
                                <div class="resolution-notes">
                                    <strong>Resolution:</strong> @ticket.ResolutionNotes
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <!-- Resolve Modal -->
    @if (showResolveModal && selectedTicket != null)
    {
        <div class="modal-bg" @onclick="CloseResolveModal">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Resolve Ticket #@selectedTicket.Id</h3>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom: 12px; font-size: 16px;"><strong>@selectedTicket.Title</strong></p>
                    <p style="font-size: 14px; color:var(--text-muted); margin-bottom: 24px;">
                        Client: @(selectedTicket.ClientName ?? "Unknown")
                    </p>
                    <div style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 12px; padding: 16px; margin-bottom: 24px; font-size: 14px; color: var(--primary); line-height: 1.5;">
                        <strong>?? Information:</strong> A transaction proof will be automatically generated and sent to the client upon resolution.
                    </div>
                    <div class="form-group">
                        <label>Resolution Notes *</label>
                        <textarea class="form-input" @bind="resolutionNotes" placeholder="Describe how the issue was resolved..."></textarea>
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="btn outline" @onclick="CloseResolveModal">Cancel</button>
                    <button class="btn success" @onclick="ConfirmResolve" disabled="@isResolving">
                        @(isResolving ? "Processing..." : "Confirm Resolution")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(notification))
    {
        <div style="position:fixed;bottom:24px;right:24px;background:@notificationColor;color:#fff;padding:16px 24px;border-radius:12px;box-shadow:var(--shadow-lg);z-index:30000;display:flex;align-items:center;gap:12px;max-width:400px;font-weight:700;animation:fadeIn 0.3s ease;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @notification
        </div>
    }
}

@code {
    private List<Ticket>? assignedTickets;
    private List<Ticket>? resolvedTickets;
    private Dictionary<int, string> ticketProofs = new();
    private HashSet<int> ticketFeedbacks = new();
    private int pendingCount;
    private int inProgressCount;
    private int resolvedTodayCount;
    private int feedbackCount;
    private bool isLoading = true;
    
    private bool showResolveModal;
    private bool isResolving;
    private Ticket? selectedTicket;
    private string resolutionNotes = "";
    private string notification = "";
    private string notificationColor = "#10b981";

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!AuthService.IsTechnician)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        await LoadTickets();
    }

    private async Task LoadTickets()
    {
        isLoading = true;
        StateHasChanged();
        
        var techId = AuthService.UserId;
        if (string.IsNullOrEmpty(techId))
        {
            isLoading = false;
            return;
        }

        try
        {
            assignedTickets = await AdminService.GetTicketsForTechnicianAsync(techId);
            var allTickets = await AdminService.GetTicketsAsync();
            var myResolvedTickets = allTickets?.Where(t => 
                t.ResolvedByTechnicianId == techId && 
                (t.Status == "Resolved" || t.Status == "Closed"))
                .ToList() ?? new List<Ticket>();
            
            var assignedResolved = assignedTickets?.Where(t => t.Status == "Resolved" || t.Status == "Closed").ToList() ?? new List<Ticket>();
            resolvedTickets = assignedResolved.Union(myResolvedTickets, new TicketComparer())
                .OrderByDescending(t => t.ResolvedAt)
                .ToList();

            pendingCount = assignedTickets?.Count(t => t.Status == "Assigned" || t.Status == "Open") ?? 0;
            inProgressCount = assignedTickets?.Count(t => t.Status == "In Progress") ?? 0;
            
            var today = DateTime.UtcNow.Date;
            resolvedTodayCount = resolvedTickets?.Count(t => t.ResolvedAt?.Date == today) ?? 0;

            ticketProofs.Clear();
            ticketFeedbacks.Clear();
            
            foreach (var ticket in resolvedTickets ?? Enumerable.Empty<Ticket>())
            {
                var proof = await AdminService.GetTicketProofAsync(ticket.Id);
                if (proof != null)
                {
                    ticketProofs[ticket.Id] = proof.ReferenceNumber;
                }
                
                if (await AdminService.HasFeedbackForTicketAsync(ticket.Id))
                {
                    ticketFeedbacks.Add(ticket.Id);
                }
            }
            
            feedbackCount = ticketFeedbacks.Count;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading technician tickets: {ex.Message}");
        }
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task StartProgress(Ticket ticket)
    {
        ticket.Status = "In Progress";
        ticket.StartedAt = DateTime.UtcNow;
        await AdminService.UpdateTicketAsync(ticket);
        await LoadTickets();
        ShowNotification("Ticket marked as In Progress", "#3b82f6");
    }

    private void OpenResolveModal(Ticket ticket)
    {
        selectedTicket = ticket;
        resolutionNotes = "";
        showResolveModal = true;
    }

    private void CloseResolveModal()
    {
        showResolveModal = false;
        selectedTicket = null;
        resolutionNotes = "";
    }

    private async Task ConfirmResolve()
    {
        if (selectedTicket == null || string.IsNullOrEmpty(AuthService.UserId)) return;
        if (string.IsNullOrWhiteSpace(resolutionNotes))
        {
            ShowNotification("Please provide resolution notes", "#ef4444");
            return;
        }

        isResolving = true;
        StateHasChanged();

        try
        {
            var (success, proofId) = await AdminService.ResolveTicketWithProofAsync(
                selectedTicket.Id, 
                AuthService.UserId,
                AuthService.FullName,
                resolutionNotes);

            if (success)
            {
                CloseResolveModal();
                await LoadTickets();
                ShowNotification(proofId.HasValue ? "Success! Proof generated." : "Ticket resolved!", "#10b981");
            }
            else
            {
                ShowNotification("Error: " + (AdminService.LastError ?? "Unknown"), "#ef4444");
            }
        }
        finally
        {
            isResolving = false;
            StateHasChanged();
        }
    }

    private void ShowNotification(string message, string color = "#10b981")
    {
        notification = message;
        notificationColor = color;
        StateHasChanged();
        _ = Task.Delay(4000).ContinueWith(_ => 
        {
            notification = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private string GetPriorityClass(string? priority) => priority?.ToLower() switch
    {
        "high" or "urgent" or "critical" => "high",
        "medium" => "medium",
        _ => "low"
    };

    private string GetStatusClass(string? status) => status?.ToLower() switch
    {
        "assigned" => "assigned",
        "in progress" => "inprogress",
        _ => "assigned"
    };
    
    private class TicketComparer : IEqualityComparer<Ticket>
    {
        public bool Equals(Ticket? x, Ticket? y) => x?.Id == y?.Id;
        public int GetHashCode(Ticket obj) => obj.Id.GetHashCode();
    }
}
