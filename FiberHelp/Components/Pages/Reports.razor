@page "/reports"
@using FiberHelp.Services
@inject FiberHelp.Services.AuthService AuthService
@inject FiberHelp.Services.ErrorHandlingService ErrorService
@inject NavigationManager Navigation
@inject FiberHelp.Services.AdminService AdminService
@inject FiberHelp.Services.TransactionService TransactionService
@inject Microsoft.JSInterop.IJSRuntime JS

<link href="css/dashboard.css" rel="stylesheet" />
<link href="css/analytics.css" rel="stylesheet" />

<div class="dashboard-root">
    <header class="topbar" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
        <div class="topbar-left">
            <p class="eyebrow" style="color:var(--text-muted);font-weight:700;font-size:12px;letter-spacing:1px;margin:0 0 4px 0;">FIBERHELP · @GetRoleLabel()</p>
            <h1 class="page-title" style="margin:0;font-size:28px;font-weight:900;color:var(--text);">Reports & Analytics</h1>
        </div>
        <div class="topbar-right" style="display:flex;gap:12px;">
            <div class="filter-group">
                <input class="search-input" placeholder="Search tickets..." @bind="searchTerm" @bind:event="oninput" @onkeyup="async _ => await OnReportsSearchChanged(searchTerm)" style="padding:10px 16px;border-radius:12px;border:1px solid var(--border-color);" />
            </div>
            <button class="btn-primary" @onclick="ExportReports" style="padding:10px 16px;border-radius:12px;background:var(--primary);color:var(--text-main);border:none;font-weight:600;cursor:pointer;box-shadow:var(--shadow-sm);">Export Tickets</button>
            <button class="btn-secondary" @onclick="ExportFeedbackReport" style="padding:10px 16px;border-radius:12px;background:var(--card-bg);color:var(--text);border:1px solid var(--border-color);font-weight:600;cursor:pointer;">Export Feedback</button>
        </div>
    </header>

    @* ==================== TICKET REPORTS SECTION ==================== *@
    <div class="kpi-grid" style="margin-bottom:24px;">
        <div class="kpi-card card-gradient-blue">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-header">TOTAL TICKETS</div>
                <h2>@totalTickets</h2>
            </div>
        </div>
        <div class="kpi-card card-gradient-orange">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-header">OPEN TICKETS</div>
                <h2>@openTickets</h2>
            </div>
        </div>
        <div class="kpi-card card-gradient-green">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-header">RESOLVED TICKETS</div>
                <h2>@resolvedTickets</h2>
            </div>
        </div>
        <div class="kpi-card" style="background:var(--card-bg);border:1px solid var(--border-color);">
            <div class="kpi-content" style="color:var(--text);">
                <div class="kpi-header" style="color:var(--text-muted);">STATUS DISTRIBUTION</div>
                <div style="display:flex; gap:6px; margin-top:20px;">
                    <div style="flex:@(openTickets > 0 ? openTickets : 1); height:12px; border-radius:6px; background:#f59e0b; position:relative;">
                        <span style="position:absolute; top:18px; left:0; font-size:11px; font-weight:700; color:var(--text-muted);">Open</span>
                    </div>
                    <div style="flex:@(resolvedTickets > 0 ? resolvedTickets : 1); height:12px; border-radius:6px; background:#10b981; position:relative;">
                        <span style="position:absolute; top:18px; left:0; font-size:11px; font-weight:700; color:var(--text-muted);">Resolved</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ==================== CLIENT FEEDBACK REPORTS SECTION ==================== *@
    <div class="charts-section" style="grid-template-columns: 1fr; margin-bottom: 24px;">
        <div class="modern-panel" style="padding:24px;">
            <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h2 style="display:flex; align-items:center; gap:10px; margin:0; font-size:18px; font-weight:800; color:var(--text);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    Client Feedback Insights
                </h2>
            </div>
      
            @if (loadingFeedback)
            {
                <p>Loading feedback data...</p>
            }
            else if (feedbackStats != null && feedbackStats.TotalCount > 0)
            {
                <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
                    <div style="background:linear-gradient(135deg, #10b981, #059669); padding:20px; border-radius:16px; color:var(--text-main); text-align:center;">
                        <div style="font-size:36px; font-weight:900; margin-bottom:4px;">@feedbackStats.AverageRating.ToString("F1") ⭐</div>
                        <div style="font-size:12px; font-weight:700; text-transform:uppercase; opacity:0.9;">Average Rating</div>
                    </div>
                    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:20px; border-radius:16px; text-align:center;">
                        <div style="font-size:32px; font-weight:800; color:var(--text-main); margin-bottom:4px;">@feedbackStats.TotalCount</div>
                        <div style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Total Feedback</div>
                    </div>
                    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:20px; border-radius:16px; text-align:center;">
                        <div style="font-size:32px; font-weight:800; color:var(--text-main); margin-bottom:4px;">@feedbackStats.WouldRecommendPercentage%</div>
                        <div style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Would Recommend</div>
                    </div>
                    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:20px; border-radius:16px; text-align:center;">
                        <div style="font-size:32px; font-weight:800; color:var(--text-main); margin-bottom:4px;">@feedbackStats.PendingCount</div>
                        <div style="font-size:12px; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Pending Review</div>
                    </div>
                </div>

                <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:16px; padding:24px;">
                    <h3 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 700; color: var(--text-main);">Rating Distribution</h3>
                    @for (int star = 5; star >= 1; star--)
                    {
                        var count = feedbackStats.RatingDistribution.GetValueOrDefault(star, 0);
                        var percentage = feedbackStats.TotalCount > 0 ? (double)count / feedbackStats.TotalCount * 100 : 0;
                        <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                            <span style="width:40px; font-weight:700; color:#f59e0b;">@star ⭐</span>
                            <div style="flex:1; height:12px; background:var(--card-bg); border-radius:6px; overflow:hidden;">
                                <div style="height:100%; border-radius:6px; background:@(star >= 4 ? "#10b981" : star == 3 ? "#eab308" : "#ef4444"); width:@percentage.ToString("F1")%"></div>
                            </div>
                            <span style="width:40px; text-align:right; font-weight:700; color:var(--text-muted);">@count</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:40px; color:var(--text-muted);">
                    <p>No feedback data available yet.</p>
                </div>
            }
        </div>
    </div>

    @* ==================== TECHNICIAN PERFORMANCE SECTION ==================== *@
    <div class="tickets-section" style="margin-bottom: 24px;">
        <div class="modern-panel">
            <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center;">
                <h2 style="display:flex; align-items:center; gap:10px; margin:0; font-size:18px; font-weight:800; color:var(--text);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                    Technician Performance
                </h2>
                <div class="panel-actions">
                    <input class="search-input" placeholder="Filter by technician..." @bind="techSearchTerm" @bind:event="oninput" style="padding:8px 12px;border-radius:10px;border:1px solid var(--border-color);font-size:13px;" />
                </div>
            </div>

            <div class="table-wrapper">
                <table class="modern-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="padding:12px; text-align:left;">Technician</th>
                            <th style="padding:12px; text-align:center;">Total Feedback</th>
                            <th style="padding:12px; text-align:center;">Average Rating</th>
                            <th style="padding:12px; text-align:center;">Positive</th>
                            <th style="padding:12px; text-align:center;">Negative</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (loadingFeedback)
                        {
                            <tr><td colspan="5">Loading...</td></tr>
                        }
                        else if (FilteredStaffPerformance != null && FilteredStaffPerformance.Any())
                        {
                            @foreach (var staff in FilteredStaffPerformance)
                            {
                                <tr>
                                    <td style="padding:12px;">
                                        <div style="display:flex; align-items:center; gap:12px;">
                                            <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#6366f1,#0ea5e9); color:var(--text-main); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:12px;">@GetInitial(staff.StaffName)</div>
                                            <span style="font-weight:600; color:var(--text);">@staff.StaffName</span>
                                        </div>
                                    </td>
                                    <td style="padding:12px; text-align:center; font-weight:600; color:var(--text-muted);">@staff.FeedbackCount</td>
                                    <td style="padding:12px; text-align:center;">
                                        <span style="display:inline-flex; padding:6px 12px; border-radius:20px; font-weight:700; font-size:13px; background:@(staff.AverageRating >= 4 ? "#dcfce7" : staff.AverageRating >= 3 ? "#fef9c3" : "#fee2e2"); color:@(staff.AverageRating >= 4 ? "#166534" : staff.AverageRating >= 3 ? "#854d0e" : "#991b1b");">
                                            @staff.AverageRating.ToString("F1") ⭐
                                        </span>
                                    </td>
                                    <td style="padding:12px; text-align:center; font-weight:700; color:#10b981;">@staff.PositiveFeedbackCount</td>
                                    <td style="padding:12px; text-align:center; font-weight:700; color:#ef4444;">@staff.NegativeFeedbackCount</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">No technician performance data available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ==================== RECENT TICKETS SECTION ==================== *@
    <div class="tickets-section">
        <div class="modern-panel">
            <div class="panel-head" style="display:flex; justify-content:space-between; align-items:center;">
                <h2 style="display:flex; align-items:center; gap:10px; margin:0; font-size:18px; font-weight:800; color:var(--text);">Recent Tickets</h2>
                <div class="panel-actions" style="display:flex; gap:10px;">
                    <select value="@periodFilter" @onchange="OnPeriodChanged" style="padding:8px 12px; border-radius:10px; border:1px solid var(--border-color); background:var(--card-bg); font-size:13px; font-weight:600; color:var(--text-main); cursor:pointer;">
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="modern-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="padding:12px; text-align:left;">#</th>
                            <th style="padding:12px; text-align:left;">Subject</th>
                            <th style="padding:12px; text-align:left;">Client</th>
                            <th style="padding:12px; text-align:left;">Status</th>
                            <th style="padding:12px; text-align:left;">Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (loadingRecent)
                        {
                            <tr><td colspan="5">Loading...</td></tr>
                        }
                        else if (PaginatedTickets != null && PaginatedTickets.Any())
                        {
                            @foreach (var t in PaginatedTickets)
                            {
                                var custName = string.IsNullOrWhiteSpace(t.ClientName) ? t.ClientId : t.ClientName;
                                <tr>
                                    <td style="padding:12px; font-weight:600; color:var(--text-muted);">@t.Id</td>
                                    <td style="padding:12px; font-weight:700; color:var(--text);">@t.Title</td>
                                    <td style="padding:12px;">
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <div style="width:32px; height:32px; border-radius:50%; background:var(--card-bg); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--text-muted);">@GetInitial(custName)</div>
                                            <span style="font-weight:600; color:var(--text-muted);">@custName</span>
                                        </div>
                                    </td>
                                    <td style="padding:12px;">
                                        <span class="status-pill @GetStatusClass(t.Status)">@t.Status</span>
                                    </td>
                                    <td style="padding:12px; color:var(--text-muted); font-size:13px;">@t.Created.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">No tickets found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;">
                    <button class="btn-secondary" style="padding:8px 12px;border-radius:10px;background:var(--card-bg);border:1px solid var(--border-color);" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">Prev</button>
                    <span style="font-size:13px;font-weight:600;color:var(--text-muted);padding:0 10px;">Page @CurrentPage of @TotalPages</span>
                    <button class="btn-secondary" style="padding:8px 12px;border-radius:10px;background:var(--card-bg);border:1px solid var(--border-color);" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Next</button>
                </div>
            }
        </div>
    </div>
  
    <Toast Message="@toast" />
</div>

@code {
    private int totalTickets = 0;
    private int openTickets = 0;
    private int resolvedTickets = 0;
    private List<FiberHelp.Models.Ticket>? recentTickets;
    private string searchTerm = string.Empty;
    private string techSearchTerm = string.Empty;
    private string toast = string.Empty;
    private bool loadingRecent = false;
    private bool loadingFeedback = false;
    private int periodFilter = 7;

    // Feedback data
    private FiberHelp.Services.TransactionService.FeedbackStatistics? feedbackStats;
    private List<FiberHelp.Services.TransactionService.StaffPerformance>? staffPerformance;

    private IEnumerable<FiberHelp.Services.TransactionService.StaffPerformance>? FilteredStaffPerformance =>
       staffPerformance?.Where(s => string.IsNullOrWhiteSpace(techSearchTerm) || s.StaffName.Contains(techSearchTerm, StringComparison.OrdinalIgnoreCase));

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => recentTickets == null || !recentTickets.Any() ? 1 : (int)Math.Ceiling(recentTickets.Count / (double)PageSize);
    private IEnumerable<FiberHelp.Models.Ticket>? PaginatedTickets => recentTickets?.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }
 
    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }
 
    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login", true); return; }
            if (!(AuthService.Role ?? "").Equals("Administrator", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/tickets", true);
                return;
            }
         
            var tickets = await AdminService.GetTicketsAsync();
            totalTickets = tickets?.Count ?? 0;
            openTickets = tickets?.Count(t => string.Equals(t.Status, "Open", StringComparison.OrdinalIgnoreCase)) ?? 0;
            resolvedTickets = tickets?.Count(t => string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase)) ?? 0;

            await ReloadRecentAsync();
            await LoadFeedbackDataAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
        }
    }

    private async Task LoadFeedbackDataAsync()
    {
        try
        {
            loadingFeedback = true;
            StateHasChanged();

            feedbackStats = await TransactionService.GetFeedbackStatisticsAsync();
            staffPerformance = await TransactionService.GetStaffPerformanceAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading feedback data: {ex.Message}");
            feedbackStats = null;
            staffPerformance = null;
        }
        finally
        {
            loadingFeedback = false;
            StateHasChanged();
        }
    }

    private string GetRoleLabel()
    {
        var role = AuthService?.Role;
        if (string.IsNullOrWhiteSpace(role)) return "GUEST";
        return role.ToUpperInvariant();
    }

    private async void ExportReports()
    {
        var rows = recentTickets ?? new List<FiberHelp.Models.Ticket>();
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Id,Title,Client,Status,Created");
        foreach (var t in rows)
            csv.AppendLine($"{t.Id},{Escape(t.Title)},{Escape(t.ClientName ?? t.ClientId)},{t.Status},{t.Created:yyyy-MM-dd HH:mm}");
        await JS.InvokeAsync<bool>("FiberExport.saveFile", "ticket_reports.csv", csv.ToString());
        toast = "Ticket reports exported"; StateHasChanged(); await Task.Delay(2000); toast = string.Empty; StateHasChanged();
    }

    private async void ExportFeedbackReport()
    {
        try
        {
            var feedbacks = await TransactionService.GetAllFeedbackAsync();
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("TicketId,ClientId,ClientName,Rating,ServiceQuality,ResponseTime,Professionalism,Communication,WouldRecommend,Category,Comments,HandledBy,SubmittedAt,Status");
     
            foreach (var f in feedbacks)
            {
                csv.AppendLine($"{f.TicketId},{f.ClientId},{Escape(f.ClientName)},{f.Rating},{f.ServiceQualityRating},{f.ResponseTimeRating},{f.ProfessionalismRating},{f.CommunicationRating},{f.WouldRecommend},{Escape(f.FeedbackCategory)},{Escape(f.Comments)},{Escape(f.HandledByName)},{f.SubmittedAt:yyyy-MM-dd HH:mm:ss},{f.Status}");
            }
     
            await JS.InvokeAsync<bool>("FiberExport.saveFile", "feedback_report.csv", csv.ToString());
            toast = "Feedback report exported"; StateHasChanged(); await Task.Delay(2000); toast = string.Empty; StateHasChanged();
        }
        catch (Exception ex)
        {
            toast = ErrorService.GetContextualMessage(ex, "export", "feedback report"); StateHasChanged(); await Task.Delay(3000); toast = string.Empty; StateHasChanged();
        }
    }

    private string Escape(string? s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        return "\"" + s.Replace("\"", "\"\"") + "\"";
    }

    private Task OnReportsSearchChanged(string val)
    {
        searchTerm = val;
        CurrentPage = 1;
        StateHasChanged();
        _ = ReloadRecentAsync();
        return Task.CompletedTask;
    }

    private string GetStatusClass(string status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status-open";
        var s = status.ToLowerInvariant();
        return s switch
        {
            "open" => "status-open",
            "in progress" => "status-inprogress",
            "resolved" => "status-resolved",
            "closed" => "status-closed",
            _ => "status-open"
        };
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var days)) periodFilter = days; else periodFilter = 7;
        CurrentPage = 1;
        await ReloadRecentAsync();
    }

    private async Task ReloadRecentAsync()
    {
        try
        {
            loadingRecent = true;
            StateHasChanged();
       
            var tickets = await AdminService.GetTicketsAsync();
            var since = DateTime.UtcNow.AddDays(-periodFilter);
            var filtered = tickets.Where(t => t.Created >= since).OrderByDescending(t => t.Created).ToList();
            recentTickets = string.IsNullOrWhiteSpace(searchTerm) ? filtered : filtered.Where(t => (t.Title ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || ((t.ClientName ?? t.ClientId) ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
       
            if (CurrentPage > TotalPages) CurrentPage = 1;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading tickets: {ex.Message}");
            recentTickets = new List<FiberHelp.Models.Ticket>();
        }
        finally
        {
            loadingRecent = false;
            StateHasChanged();
        }
    }

    private string GetInitial(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "?";
        var ch = s.Trim()[0];
        return char.ToUpperInvariant(ch).ToString();
    }
}
