  private object GetTicketTrendsData()
  {
    var days = 30;
    var labels = Enumerable.Range(0, days).Select(i => DateTime.UtcNow.AddDays(-days + i + 1).ToString("MMM dd")).ToArray();
    var data = Enumerable.Range(0, days).Select(i =>
    {
      var date = DateTime.UtcNow.AddDays(-days + i + 1).Date;
      return tickets?.Count(t => t.Created.Date == date) ?? 0;
    }).ToArray();

    return new { labels, datasets = new[] { new { label = "Tickets", data, borderColor = "#3b82f6", backgroundColor = "rgba(59, 130, 246, 0.1)", fill = true } } };
  }

  private object GetRevenueExpensesData()
  {
    var months = 6;
    var labels = new List<string>();
    var revenueData = new List<double>();
    var expenseData = new List<double>();
    
    for (int i = months - 1; i >= 0; i--)
    {
      var targetMonth = DateTime.UtcNow.AddMonths(-i);
      var monthStart = new DateTime(targetMonth.Year, targetMonth.Month, 1);
      var monthEnd = monthStart.AddMonths(1);
      
      labels.Add(targetMonth.ToString("MMM"));
      
      var monthRevenue = invoices?
        .Where(inv => 
          string.Equals(inv.Status, "Paid", StringComparison.OrdinalIgnoreCase) && 
          ((inv.PaidDate.HasValue && inv.PaidDate.Value >= monthStart && inv.PaidDate.Value < monthEnd) ||
           (!inv.PaidDate.HasValue && inv.IssueDate >= monthStart && inv.IssueDate < monthEnd))
        )
        .Sum(inv => inv.AmountDue) ?? 0m;
      
      revenueData.Add((double)monthRevenue);
      
      var monthExpenses = expenses?
        .Where(e => e.Date >= monthStart && e.Date < monthEnd)
        .Sum(e => e.Amount) ?? 0m;
      
      expenseData.Add((double)monthExpenses);
    }

    return new { 
      labels = labels.ToArray(), 
      datasets = new[] {
        new { label = "Revenue", data = revenueData.ToArray(), backgroundColor = "#10b981" },
        new { label = "Expenses", data = expenseData.ToArray(), backgroundColor = "#ef4444" }
      }
    };
  }

  private object GetClientGrowthData()
  {
    var months = 6;
    var labels = new List<string>();
    var data = new List<int>();
    
    for (int i = months - 1; i >= 0; i--)
    {
      var targetMonth = DateTime.UtcNow.AddMonths(-i);
      var monthStart = new DateTime(targetMonth.Year, targetMonth.Month, 1);
      var monthEnd = monthStart.AddMonths(1);
      
      labels.Add(targetMonth.ToString("MMM"));
      
      var clientCount = customers?.Count(c => c.JoinDate >= monthStart && c.JoinDate < monthEnd) ?? 0;
      data.Add(clientCount);
    }

    return new { 
      labels = labels.ToArray(), 
      datasets = new[] { 
        new { 
          label = "New Clients", 
          data = data.ToArray(), 
          borderColor = "#8b5cf6", 
          backgroundColor = "rgba(139, 92, 246, 0.2)", 
          fill = true 
        } 
      } 
    };
  }

  private object GetPriorityDistributionData()
  {
    var priorities = new[] { "Low", "Medium", "High", "Critical" };
    var data = priorities.Select(p => tickets?.Count(t => string.Equals(t.Priority, p, StringComparison.OrdinalIgnoreCase)) ?? 0).ToArray();
    var colors = new[] { "#10b981", "#3b82f6", "#f59e0b", "#ef4444" };

    return new { labels = priorities, datasets = new[] { new { data, backgroundColor = colors } } };
  }
  
  private string GetTimeAgo(DateTime date)
  {
    var span = DateTime.UtcNow - date;
    if (span.TotalMinutes < 1) return "Just now";
    if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
    if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
    if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
    return date.ToString("MMM dd");
  }

