@page "/"
@using FiberHelp.Models
@inject FiberHelp.Services.AuthService AuthService
@inject FiberHelp.Services.AdminService AdminService
@inject FiberHelp.Services.BillingService BillingService
@inject FiberHelp.Services.AuditLoggingService AuditLog
@inject NavigationManager Navigation
@inject IJSRuntime JS

<link href="css/dashboard.css" rel="stylesheet" />
<link href="css/analytics.css" rel="stylesheet" />

<div class="dashboard-root">
  <header class="topbar">
    <div class="topbar-left">
      <p class="eyebrow">FIBERHELP · @GetRoleLabel()</p>
      <p class="welcome-text">Welcome back, @(AuthService.FullName ?? "User")! Here's what's happening today.</p>
    </div>
  </header>

  @if (IsAgentRole)
  {
    <!-- Agent: Ticket-focused KPIs only -->
    <div class="kpi-grid">
      <!-- Open Tickets -->
      <div class="kpi-card card-gradient-red clickable" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/tickets")'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">OPEN TICKETS</div>
          <h2>@OpenTickets</h2>
          <div class="kpi-trend"><span class="trend-badge trend-up">Need attention</span></div>
        </div>
      </div>

      <!-- In Progress -->
      <div class="kpi-card card-gradient-orange clickable" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/tickets")'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">IN PROGRESS</div>
          <h2>@InProgressTickets</h2>
          <div class="kpi-trend"><span class="trend-badge trend-neutral">Currently working</span></div>
        </div>
      </div>

      <!-- Resolved This Week -->
      <div class="kpi-card card-gradient-green clickable" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/tickets")'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">RESOLVED THIS WEEK</div>
          <h2>@ResolvedThisWeek</h2>
          <div class="kpi-trend"><span class="trend-badge trend-up">Great work!</span></div>
        </div>
      </div>

      <!-- Total Tickets -->
      <div class="kpi-card card-gradient-blue clickable" role="button" tabindex="0" @onclick='() => Navigation.NavigateTo("/tickets")'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">TOTAL TICKETS</div>
          <h2>@TotalTickets</h2>
          <div class="kpi-trend"><span class="trend-badge trend-neutral">All assigned</span></div>
        </div>
      </div>
    </div>

    <!-- AGENT ANALYTICS - Ticket focused only -->
    <div class="charts-section" style="grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));">
      <!-- Ticket Trends Chart -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Ticket Trends</h3>
          <p class="chart-subtitle">Last 30 days</p>
        </div>
        <div class="chart-body">
          <canvas id="agentTicketTrendsChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>

      <!-- Priority Distribution -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Priority Distribution</h3>
          <p class="chart-subtitle">Current breakdown</p>
        </div>
        <div class="chart-body">
          <canvas id="agentPriorityChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>
    </div>
  }
  else
  {
    <!-- Admin: full KPI set with enhanced metrics -->
    <div class="kpi-grid">
      <div class="kpi-card card-gradient-red clickable" role="button" tabindex="0" @onclick='() => NavigateRoleAware("/tickets")' @onkeydown='(e=>OnCardKey(e, () => NavigateRoleAware("/tickets")))'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="6" width="18" height="12" rx="2"></rect>
            <circle cx="9" cy="12" r="1.5"></circle>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">OPEN TICKETS</div>
          <h2>@OpenTickets</h2>
          <div class="kpi-trend"><span class="trend-badge trend-up">@OpenTrend</span></div>
        </div>
      </div>

      <div class="kpi-card card-gradient-green clickable" role="button" tabindex="0">
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">TOTAL REVENUE</div>
          <h2>@totalRevenue.ToString("C0")</h2>
          <div class="kpi-trend"><span class="trend-badge @(revenueTrend >= 0 ? "trend-up" : "trend-down")">@(revenueTrend >= 0 ? "↑" : "↓") @Math.Abs(revenueTrend).ToString("F1")%</span></div>
        </div>
      </div>

      <div class="kpi-card card-gradient-purple clickable" role="button" tabindex="0" @onclick='() => NavigateRoleAware("/reports")'>
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">RESOLUTION RATE</div>
          <h2>@ticketResolutionRate.ToString("F1")%</h2>
          <div class="kpi-trend"><span class="trend-badge @(resolutionTrend >= 0 ? "trend-up" : "trend-down")">@(resolutionTrend >= 0 ? "↑" : "↓") @Math.Abs(resolutionTrend).ToString("F1")%</span></div>
        </div>
      </div>

      <div class="kpi-card card-gradient-blue clickable" role="button" tabindex="0">
        <div class="kpi-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div class="kpi-content">
          <div class="kpi-header">CLIENT GROWTH</div>
          <h2>@clientGrowth.ToString("F1")%</h2>
          <div class="kpi-trend"><span class="trend-badge @(clientGrowthTrend >= 0 ? "trend-up" : "trend-down")">@(clientGrowthTrend >= 0 ? "↑" : "↓") @Math.Abs(clientGrowthTrend).ToString("F1")%</span></div>
        </div>
      </div>
    </div>

    <!-- ANALYTICS SECTION FOR ADMIN -->
    <div class="charts-section" style="grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));">
      <!-- Ticket Trends Chart -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Ticket Trends</h3>
          <p class="chart-subtitle">Last 30 days</p>
        </div>
        <div class="chart-body">
          <canvas id="miniTicketTrendsChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>

      <!-- Revenue vs Expenses -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Revenue vs Expenses</h3>
          <p class="chart-subtitle">Monthly comparison</p>
        </div>
        <div class="chart-body">
          <canvas id="miniRevenueExpensesChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>

      <!-- Priority Distribution -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Priority Distribution</h3>
          <p class="chart-subtitle">Current breakdown</p>
        </div>
        <div class="chart-body">
          <canvas id="miniPriorityChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>

      <!-- Client Growth -->
      <div class="chart-card">
        <div class="chart-header">
          <h3>Client Growth</h3>
          <p class="chart-subtitle">New clients monthly</p>
        </div>
        <div class="chart-body">
          <canvas id="miniClientGrowthChart" style="height: 250px; width: 100%;"></canvas>
        </div>
      </div>
    </div>
  }

  <!-- LATEST TICKETS TABLE (both roles) -->
  <div class="tickets-section">
    <div class="modern-panel">
      <div class="panel-head">
        <div>
          <h2>@(IsAgentRole ? "Your Latest Tickets" : "Latest Tickets")</h2>
          <p class="muted-text">Most recent customer issues</p>
        </div>
        <div class="panel-actions">
          <div class="filter-pill">This week</div>
          <button class="btn-text" @onclick="NavigateToTickets">View all &#8594;</button>
        </div>
      </div>

      <div class="table-wrapper">
        <table class="modern-table">
          <thead>
            <tr>
              <th>Ticket #</th>
              <th>Client</th>
              <th>Subject</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @if (tickets != null && tickets.Any())
            {
              foreach (var t in tickets.Take(5))
              {
                <tr>
                  <td><span class="ticket-id">#@t.Id</span></td>
                  <td>
                    <div class="customer-cell">
                      <div class="customer-avatar">@GetInitials(t.ClientName ?? t.ClientId ?? "")</div>
                      <span>@(t.ClientName ?? t.ClientId)</span>
                    </div>
                  </td>
                  <td><span class="ticket-subject">@t.Title</span></td>
                  <td><span class="status-pill @GetStatusClass(t.Status)">@t.Status</span></td>
                  <td><span class="priority-badge @GetPriorityClass(t.Priority)">@t.Priority</span></td>
                  <td><span class="time-ago">@GetTimeAgo(t.Created)</span></td>
                  <td>
                    <button class="btn-action" @onclick="NavigateToTickets">
                      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </button>
                  </td>
                </tr>
              }
            }
            else
            {
              <tr>
                <td colspan="7" class="no-data">
                  <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                  </svg>
                  <p>No tickets available</p>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  @if (AuthService.IsAdministrator)
  {
    <!-- Recent Activity & Audit Log -->
    <div class="audit-section">
      <div class="audit-header">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          Recent Activity Log
        </h3>
        <div class="audit-filters">
          <button class="filter-pill" style="@(auditFilter == "All" ? "background:var(--primary);color:#FFFFFF;" : "")" @onclick='() => FilterAudit("All")'>All</button>
          <button class="filter-pill" style="@(auditFilter == "Authentication" ? "background:var(--primary);color:#FFFFFF;" : "")" @onclick='() => FilterAudit("Authentication")'>Logins</button>
          <button class="filter-pill" style="@(auditFilter == "UserActivity" ? "background:var(--primary);color:#FFFFFF;" : "")" @onclick='() => FilterAudit("UserActivity")'>Activities</button>
          <button class="filter-pill" style="@(auditFilter == "SystemError" ? "background:var(--primary);color:#FFFFFF;" : "")" @onclick='() => FilterAudit("SystemError")'>Errors</button>
        </div>
      </div>

      @if (auditLogs != null && auditLogs.Any())
      {
        <div class="table-wrapper">
          <table class="modern-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Event</th>
                <th>User</th>
                <th>Details</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var log in PaginatedAuditLogs)
              {
                <tr style="@(log.IsSuccess ? "" : "background:rgba(239, 68, 68, 0.1);")">
                  <td class="time-ago">@log.Timestamp.ToLocalTime().ToString("MMM dd, hh:mm tt")</td>
                  <td>
                    <span class="status-pill" style="background:rgba(255,255,255,0.05); color:var(--text);">
                      @GetAuditIcon(log.EventType) @log.EventType
                    </span>
                  </td>
                  <td style="font-weight:600;">@(log.UserEmail ?? "System")</td>
                  <td class="muted-text">@TruncateMessage(log.Message, 80)</td>
                  <td style="font-weight:800;font-size:16px;">
                    @if (log.IsSuccess)
                    {
                      <span style="color:#10b981;">&#10003;</span>
                    }
                    else
                    {
                      <span style="color:#ef4444;">&#10007;</span>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        @if (AuditTotalPages > 1)
        {
          <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;">
            <button class="btn-text" disabled="@(auditCurrentPage == 1)" @onclick="() => { auditCurrentPage--; StateHasChanged(); }">&#9664; Prev</button>
            <span style="color:var(--text-muted);font-size:13px;font-weight:600;">Page @auditCurrentPage of @AuditTotalPages</span>
            <button class="btn-text" disabled="@(auditCurrentPage == AuditTotalPages)" @onclick="() => { auditCurrentPage++; StateHasChanged(); }">Next &#9654;</button>
          </div>
        }
      }
      else
      {
        <div class="no-data">
          <p>No activity logs recorded yet. Logs will appear after login attempts and user actions.</p>
        </div>
      }
    </div>
  }
</div>

@code {
  private List<Ticket>? tickets;
  private List<Client>? customers;
  private List<Invoice>? invoices;
  private List<Expense>? expenses;
  private List<AuditLog>? auditLogs;
  private string auditFilter = "All";
  private int auditCurrentPage = 1;
  private int auditPageSize = 10;
  private int AuditTotalPages => auditLogs == null || !auditLogs.Any() ? 1 : (int)Math.Ceiling(auditLogs.Count / (double)auditPageSize);
  private IEnumerable<AuditLog> PaginatedAuditLogs => auditLogs?.Skip((auditCurrentPage - 1) * auditPageSize).Take(auditPageSize) ?? Enumerable.Empty<AuditLog>();

  // Enhanced metrics
  private decimal totalRevenue;
  private double ticketResolutionRate;
  private double clientGrowth;
  private double revenueTrend;
  private double resolutionTrend;
  private double clientGrowthTrend;

  // KPI computed properties (tickets-focused)
  private int OpenTickets { get; set; }
  private int InProgressTickets { get; set; }
  private int TotalTickets { get; set; }
  private string AvgResponseLabel { get; set; } = "0 hrs";
  private int ResolvedThisWeek { get; set; }
  private string OpenTrend { get; set; } = "+0%";
  private string TotalTrend { get; set; } = "0";
  private string AvgTrend { get; set; } = "-";
  private string ResolvedTrend { get; set; } = "+0%";

  // Donut data structures
  private const double DonutRadius = 70.0;
  private double Circ => 2 * Math.PI * DonutRadius;
  private record DonutSeg(string Label, int Count, string Color, string Percent, String Dash, String Gap, String Offset);
  private List<DonutSeg> TicketDonut = new();
  private List<DonutSeg> InvoiceDonut = new();
  private int TotalInvoices => invoices?.Count ?? 0;

  // Customer growth line (last 6 months)
  private double[] CustomerGrowth = Array.Empty<double>();
  private string[] Last6Months = Array.Empty<string>();
  private string CustomerLinePath => BuildLinePath(CustomerGrowth);

  // Use AuthService.IsAgent which correctly checks for both "Agent" and "Support Agent"
  private bool IsAgentRole => AuthService.IsAgent;

  protected override async Task OnInitializedAsync()
  {
    AuthService.AuthenticationStateChanged += OnAuthChanged;
    if (!AuthService.IsAuthenticated)
    {
      Navigation.NavigateTo("/login", true);
      return;
    }

    // Redirect Technicians to their dedicated dashboard
    if (AuthService.IsTechnician)
    {
      Navigation.NavigateTo("/technician/dashboard", true);
      return;
    }

    await LoadDataAsync();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (IsAgentRole)
      {
        await RenderAgentCharts();
      }
      else
      {
        await RenderMiniCharts();
      }
    }
  }

  private async void OnAuthChanged()
  {
    if (AuthService.IsAuthenticated)
    {
      await LoadDataAsync();
    }
    else
    {
      Navigation.NavigateTo("/login", true);
    }
    StateHasChanged();
  }

  private async Task LoadDataAsync()
  {
    tickets = await AdminService.GetTicketsAsync();
    customers = await AdminService.GetCustomersAsync();
    invoices = await BillingService.GetInvoicesAsync();
    expenses = await BillingService.GetExpensesAsync();

    // Load audit logs for admin dashboard
    if (AuthService.IsAdministrator)
    {
      await LoadAuditLogsAsync();
    }

    ComputeKpis();
    ComputeAnalyticsMetrics();
    BuildTicketDonut();
    BuildInvoiceDonut();
    BuildCustomerGrowth();
    StateHasChanged();

    // Re-render charts after data is loaded
    await Task.Delay(100); // Small delay to ensure DOM is ready
    if (IsAgentRole)
    {
      await RenderAgentCharts();
    }
    else
    {
      await RenderMiniCharts();
    }
  }

  private void ComputeKpis()
  {
    TotalTickets = tickets?.Count ?? 0;
    OpenTickets = tickets?.Count(t => string.Equals(t.Status, "Open", StringComparison.OrdinalIgnoreCase)) ?? 0;
    InProgressTickets = tickets?.Count(t => string.Equals(t.Status, "In Progress", StringComparison.OrdinalIgnoreCase) || 
                                            string.Equals(t.Status, "Assigned", StringComparison.OrdinalIgnoreCase)) ?? 0;

    if (tickets != null && tickets.Count > 0)
    {
      var avgHours = tickets.Average(t => (DateTime.UtcNow - t.Created).TotalHours);
      AvgResponseLabel = $"~{Math.Round(avgHours)} hrs";
    }
    else AvgResponseLabel = "0 hrs";

    var weekAgo = DateTime.UtcNow.AddDays(-7);
    ResolvedThisWeek = tickets?.Count(t => (string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase) || string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase)) && t.Created >= weekAgo) ?? 0;

    OpenTrend = TotalTickets > 0 ? $"+{Math.Round((double)OpenTickets / Math.Max(1, TotalTickets) * 100)}%" : "+0%";
    TotalTrend = "Same";
    AvgTrend = "-5%";
    ResolvedTrend = ResolvedThisWeek > 0 ? $"+{ResolvedThisWeek}%" : "+0%";
  }

  private void ComputeAnalyticsMetrics()
  {
    var now = DateTime.UtcNow;
    var periodStart = now.AddDays(-30);
    var previousPeriodStart = periodStart.AddDays(-30);

    // Revenue calculation from paid invoices
    var currentRevenue = invoices?.Where(i => 
      string.Equals(i.Status, "Paid", StringComparison.OrdinalIgnoreCase) && 
      ((i.PaidDate.HasValue && i.PaidDate.Value >= periodStart) || 
       (!i.PaidDate.HasValue && i.IssueDate >= periodStart))
    ).Sum(i => i.AmountDue) ?? 0m;
    
    var previousRevenue = invoices?.Where(i => 
      string.Equals(i.Status, "Paid", StringComparison.OrdinalIgnoreCase) && 
      ((i.PaidDate.HasValue && i.PaidDate.Value >= previousPeriodStart && i.PaidDate.Value < periodStart) ||
       (!i.PaidDate.HasValue && i.IssueDate >= previousPeriodStart && i.IssueDate < periodStart))
    ).Sum(i => i.AmountDue) ?? 0m;
    
    totalRevenue = currentRevenue;
    
    // Calculate revenue trend
    if (previousRevenue > 0)
    {
      revenueTrend = (double)(currentRevenue - previousRevenue) / (double)previousRevenue * 100;
    }
    else if (currentRevenue > 0)
    {
      revenueTrend = 100;
    }
    else
    {
      revenueTrend = 0;
    }

    // Ticket Resolution Rate - calculate based on all tickets
    var allTickets = tickets?.ToList() ?? new();
    
    if (allTickets.Any())
    {
      var resolvedAll = allTickets.Count(t => 
        string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase)
      );
      ticketResolutionRate = (double)resolvedAll / allTickets.Count * 100;
    }
    else
    {
      ticketResolutionRate = 0;
    }
    
    // Resolution trend
    var currentTickets = allTickets.Where(t => t.Created >= periodStart).ToList();
    var previousTickets = allTickets.Where(t => t.Created >= previousPeriodStart && t.Created < periodStart).ToList();
    
    if (currentTickets.Any() && previousTickets.Any())
    {
      var resolvedCurrent = currentTickets.Count(t => 
        string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase)
      );
      var currentRate = (double)resolvedCurrent / currentTickets.Count * 100;
      
      var resolvedPrevious = previousTickets.Count(t => 
        string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase)
      );
      var previousRate = (double)resolvedPrevious / previousTickets.Count * 100;
      
      if (previousRate > 0)
      {
        resolutionTrend = (currentRate - previousRate) / previousRate * 100;
      }
      else
      {
        resolutionTrend = 0;
      }
    }
    else
    {
      resolutionTrend = 0;
    }

    // Client Growth - compare current period to previous period
    var allClients = customers?.ToList() ?? new();
    var thisMonthStart = new DateTime(now.Year, now.Month, 1);
    var lastMonthStart = thisMonthStart.AddMonths(-1);
    
    var currentMonthClients = allClients.Count(c => c.JoinDate >= thisMonthStart);
    var lastMonthClients = allClients.Count(c => c.JoinDate >= lastMonthStart && c.JoinDate < thisMonthStart);
    
    // Calculate growth percentage based on actual data
    if (lastMonthClients > 0)
    {
      clientGrowth = (double)(currentMonthClients - lastMonthClients) / lastMonthClients * 100;
    }
    else if (currentMonthClients > 0)
    {
      clientGrowth = 100;
    }
    else
    {
      clientGrowth = 0;
    }
    
    clientGrowthTrend = clientGrowth;
  }

  private void BuildTicketDonut()
  {
    var statusGroups = new (string key, string label, string color)[] {
      ("Open", "Open", "#3b82f6"),
      ("In Progress", "In Progress", "#f59e0b"),
      ("Resolved", "Resolved", "#10b981"),
      ("Closed", "Closed", "#94a3b8")
    };

    var counts = statusGroups.Select(s => new {
      s.label, s.color,
      count = tickets?.Count(t => string.Equals(t.Status, s.key, StringComparison.OrdinalIgnoreCase)) ?? 0
    }).ToList();

    TicketDonut = BuildDonut(counts.Select(c => (c.label, c.count, c.color)).ToList());
  }

  private void BuildInvoiceDonut()
  {
    var statusGroups = new (string key, string label, string color)[] {
      ("Paid", "Paid", "#10b981"),
      ("Pending", "Pending", "#f59e0b")
    };
    var counts = statusGroups.Select(s => new {
      s.label, s.color,
      count = invoices?.Count(i => string.Equals(i.Status, s.key, StringComparison.OrdinalIgnoreCase)) ?? 0
    }).ToList();

    InvoiceDonut = BuildDonut(counts.Select(c => (c.label, c.count, c.color)).ToList());
  }

  private List<DonutSeg> BuildDonut(List<(string label, int count, string color)> items)
  {
    var total = Math.Max(1, items.Sum(i => i.count));
    double acc = 0;
    var list = new List<DonutSeg>();
    foreach (var it in items)
    {
      var percent = (double)it.count / total;
      var dash = percent * Circ;
      var gap = Circ - dash;
      var seg = new DonutSeg(it.label, it.count, it.color,
        Math.Round(percent * 100).ToString(),
        dash.ToString("F2"),
        gap.ToString("F2"),
        acc.ToString("F2"));
      list.Add(seg);
      acc += dash;
    }
    return list;
  }

  private void BuildCustomerGrowth()
  {
    var labels = new List<string>();
    var data = new List<double>();
    for (int i = 5; i >= 0; i--)
    {
      var dt = DateTime.UtcNow.AddMonths(-i);
      labels.Add(dt.ToString("MMM"));
      var monthStart = new DateTime(dt.Year, dt.Month, 1, 0, 0, 0, DateTimeKind.Utc);
      var monthEnd = monthStart.AddMonths(1);
      var count = customers?.Count(c => c.JoinDate >= monthStart && c.JoinDate < monthEnd) ?? 0;
      data.Add(count);
    }
    Last6Months = labels.ToArray();
    CustomerGrowth = data.ToArray();
  }

  private string BuildLinePath(double[] pts)
  {
    if (pts == null || pts.Length == 0) return string.Empty;
    var max = Math.Max(1.0, pts.Max());
    var step = 600.0 / (pts.Length - 1);
    var d = $"M 0 {180 - (pts[0] / max) * 160}";
    for (int i = 1; i < pts.Length; i++) d += $" L {i * step} {180 - (pts[i] / max) * 160}";
    return d;
  }

